<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Cross.EdiEngine</id>
    <version>0.0.0</version>
    <authors>Denis Peshkov</authors>
    <owners>Denis Peshkov</owners>
    <copyright>Copyright Denis Peshkov</copyright>
    <projectUrl>https://github.com/denis-peshkov/Cross.EdiEngine</projectUrl>
    <repository type="git" url="https://github.com/denis-peshkov/Cross.EdiEngine.git" />
    <description>Simple .NET EDI X12 Reader, Writer and Validator. EDI JSON and XML Serialization and Deserialization.</description>
    <tags>.NET EDI X12 JSON XML EdiReader EdiWriter EdiParser EdiXml EdiJson FunctionalAcknowledgment SyntaxNotes NetCore</tags>
    <icon>icon.png</icon>
    <readme>docs\README.md</readme>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes>
	Fix incorrect ISA [13] segment filling.
	Add possibility to set IsaAcknowledgementRequest segment.
    </releaseNotes>
  </metadata>
  <files>
    <file src="..\EdiEngine\bin\Release\netstandard2.0\EdiEngine*.* " target="lib\netstandard2.0" />
    <file src="..\EdiEngine\bin\Release\net6.0\EdiEngine*.* " target="lib\net6.0" />
    <file src="..\EdiEngine\bin\Release\net8.0\EdiEngine*.* " target="lib\net8.0" />
    <file src="..\README.md" target="docs\" />
    <file src="..\icon.png" target="" />
  </files>
</package>
